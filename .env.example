# .env.example
# Copy this to .env and fill in the real values.

# Database
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=supersecretdbpassword
POSTGRES_DB=hr_system
DATABASE_URL=postgresql+asyncpg://hr_admin:supersecretdbpassword@db:5432/hr_system

# Auth
JWT_SECRET=generate_a_random_long_string_here
CSRF_SECRET=another_random_string_here

# AI Providers (Member 1 will fill these)
GEMINI_API_KEY=
GROQ_API_KEY=

# Hugging Face
HF_TOKEN=your_hf_token_here

# Frontend
VITE_API_URL=http://localhost/api
