# Docker Compose settings. Copy to .env (git-ignored) and fill in.
# App settings (JWT_SECRET, LLM keys) live in backend/.env, not here.

# Password of the "trusthr" PostgreSQL user inside the stack.
POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 only. Change them if another app already uses one.
WEB_PORT=8080
MAILPIT_UI_PORT=8025
TEST_DB_PORT=5433
