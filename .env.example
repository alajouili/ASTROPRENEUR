# Docker Compose settings. Copy to .env (git-ignored) and fill in.
# App settings (JWT_SECRET, LLM keys, HF_TOKEN for Prompt Guard) live in backend/.env:
# see backend/.env.example.

# Password of the "trusthr" PostgreSQL user inside the stack. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 only. Change them if another app already uses one.
WEB_PORT=8080
MAILPIT_UI_PORT=8025
TEST_DB_PORT=5433
