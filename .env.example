# TrustHR AI Environment Configuration
APP_NAME=TrustHR AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Security
SECURITY_MAX_UPLOAD_BYTES=10485760  # 10MB
SECURITY_STRICT_PROMPT_CHECK=True
SECURITY_ALLOWED_MIME_TYPES=text/plain,application/pdf

# Database (SQLite default for speed, PostgreSQL compatible)
DATABASE_URL=sqlite+aiosqlite:///./trusthr.db

# LLM Providers (Mock engine built-in for zero-dependency offline evaluation & Gemini/OpenAI if set)
LLM_PROVIDER=mock  # Options: mock, gemini, openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mailpit / SMTP Integration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hr@trusthr.internal
