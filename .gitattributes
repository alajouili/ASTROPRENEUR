# Auto detect text files and perform LF normalization on checkout/commit
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
