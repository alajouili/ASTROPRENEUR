# Copy to backend/.env and fill in. Never commit the real .env.
# Keep comments on their own lines: an inline comment after an empty value is read as the value.

APP_ENV=dev
DATABASE_URL=postgresql+psycopg://trusthr:CHANGE_ME@localhost:5432/trusthr
# 32+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=30
# true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
MAX_FILES_PER_BATCH=200
MAX_TEXT_CHARS=20000

# LLM: offline | gemini | groq. "offline" is a deterministic keyword heuristic,
# labelled SIMULATED in the UI and the audit log.
LLM_PROVIDER=offline
# none | gemini | groq
LLM_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
# copy the exact model id from Google AI Studio
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=30

# Optional second injection detector (Llama Prompt Guard 2 86M): off | groq | local
# (local needs transformers + torch)
PROMPT_GUARD_MODE=off
PROMPT_GUARD_THRESHOLD=0.5

SHORTLIST_SIZE=5
# dev: run the background worker inside the API process
EMBEDDED_WORKER=true

# Demo passwords are not read from this file. Pass them to the seed script in the shell:
#   SEED_RECRUITER_PASSWORD=... SEED_ADMIN_PASSWORD=... SEED_EMPLOYEE_PASSWORD=... python -m scripts.seed
# or leave them unset and the script generates random ones and prints them once.
